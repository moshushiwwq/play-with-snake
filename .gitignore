# 构建与发布产物
# 服务端单文件 exe 随仓库发布（客户端 exe 仍然不入库，体积更大且非必需）；
# 其余构建中间产物与构建日志不纳入仓库。
release/*
!release/PlayWithSnake-Server.exe
!release/version.json
build/dist/
build/work/
build/logs/
build/artifacts/
build/*.spec.bak
build/pip-freeze.txt

# 自检产物（截图与临时运行目录）
shots/
_pkgdata/
_pkgtest*/

# 旧版本归档（保留在本机，不发布）
legacy/

# 运行期数据（可能含密码盐/哈希、IP、成绩）
server_data/
snake_server.config.json
*.db
*.db-journal
*.log
*.sqlite

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器与计划
.trae/
.vscode/
.idea/

# 系统
Thumbs.db
Desktop.ini

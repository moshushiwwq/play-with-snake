# 构建与发布产物
# 完整 onedir 产物约 412 MB/端（含 190 MB 的 Qt6WebEngineCore.dll，超出 GitHub 单文件 100 MB 限制），
# 因此只跟踪两端的主程序 exe（各约 2 MB），其余依赖目录留在本机。
release/*
!release/PlayWithSnake-Client/
release/PlayWithSnake-Client/*
!release/PlayWithSnake-Client/PlayWithSnake-Client.exe
!release/PlayWithSnake-Server/
release/PlayWithSnake-Server/*
!release/PlayWithSnake-Server/PlayWithSnake-Server.exe
build/dist/
build/work/
build/artifacts/
build/*.spec.bak
build/pip-freeze.txt

# 自检产物（截图与临时运行目录）
shots/
_pkgdata/
_pkgtest*/

# 旧版本归档（保留在本机，不发布）
legacy/

# 运行期数据（可能含密码盐/哈希、IP、成绩）
server_data/
snake_server.config.json
*.db
*.db-journal
*.log
*.sqlite

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器与计划
.trae/
.vscode/
.idea/

# 系统
Thumbs.db
Desktop.ini
